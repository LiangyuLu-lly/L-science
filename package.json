{
  "name": "l-science",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "L-science - 本地优先 AI 科研工作台",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:json": "node scripts/doctor.mjs --json",
    "verify:kernel": "node scripts/verify-kernel.mjs",
    "verify:backend": "npm run build && node scripts/verify-backend.mjs",
    "verify:providers": "npm run build && node scripts/verify-providers.mjs",
    "verify:turn": "npm run build && node scripts/verify-turn.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "verify:smoke": "npm run build && node scripts/verify-smoke.mjs",
    "verify:registry": "npm run build && node scripts/verify-registry.mjs",
    "verify:hostapi": "npm run build && node scripts/verify-hostapi.mjs",
    "verify:reviewer": "npm run build && node scripts/verify-reviewer.mjs",
    "verify:skills": "npm run build && node scripts/verify-skills.mjs",
    "verify:connectors": "npm run build && node scripts/verify-connectors.mjs",
    "credential": "node scripts/credential.mjs",
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "build:ui": "npm run build --workspace @l-science/ui",
    "dev:ui": "npm run dev --workspace @l-science/ui",
    "dev:shell": "npm run build && node scripts/dev-shell.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "typecheck:ui": "npm run typecheck --workspace @l-science/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "concurrently": "10.0.4",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
